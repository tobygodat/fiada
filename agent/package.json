    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@strata/shared": "*",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.0"
  }
}
