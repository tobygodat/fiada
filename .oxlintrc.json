{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/dist/**",
    ".fiada/**",
    ".strata/**",
    // Scripts recorded with a merged PR's media, kept as a record and not run again.
    "docs/pr-media/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    // Destructuring a field away to keep the rest is how tests drop fields.
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    // The code uses comma sequences as single-statement loop and branch bodies on purpose.
    "no-unused-expressions": "off",

    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/require-readable-spacing": "error",

    // The rules below stay off. The first four ask for a decoder that parses
    // input at each I/O boundary into a domain type. The indexer and agent
    // instead check request bodies, hook payloads, MCP messages, model replies
    // and stored JSON field by field in normalizers that take `unknown`, and
    // the published agent may import only Node's built-ins. Moving to decoders
    // changes what malformed input does, so it is its own piece of work.
    // 77 findings: those field checks, plus browser feature probes such as `typeof matchMedia === 'function'`.
    "anti-slop/no-runtime-typeof": "off",
    // 26 findings: the normalizers and parsers that take raw input (normalizeGrouping, cleanFences, answersIn, hook fields).
    "anti-slop/no-unknown-parameters": "off",
    // 9 findings: stores return a grouping for normalizeGrouping to check, and the Mongo key escaper maps any stored value.
    "anti-slop/no-unknown-returns": "off",
    // 10 findings: the agent reads Claude Code, Cursor and MCP messages as Record<string, any>, and the normalizers' isObj guards.
    "anti-slop/no-unsafe-dictionary-type": "off",
    // 185 findings: most cast parsed JSON or a caught error (`err as Error`); they go when decoders arrive, and a SAFETY line on each would only restate the cast.
    "anti-slop/require-safety-comment-for-type-assertion": "off",
    // 50 findings: `...(x ? { k } : {})` adds optional fields in expressions. Separate statements reorder keys in written JSON
    // (fiada.grouping.json, API and MCP replies), and `k: x ? v : undefined` sends undefined to headers and MongoDB.
    "anti-slop/no-conditional-empty-object-spread": "off"
  }
}
