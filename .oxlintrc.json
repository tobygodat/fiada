{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/dist/**",
    ".fiada/**",
    ".strata/**",
    // Scripts recorded with a merged PR's media, kept as a record and not run again.
    "docs/pr-media/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    // Destructuring a field away to keep the rest is how tests drop fields.
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    // The code uses comma sequences as single-statement loop and branch bodies on purpose.
    "no-unused-expressions": "off",

    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",

    // The rules below stay off. Nearly all they still find is input at an I/O
    // boundary, which they want parsed by a decoder into a domain type; the
    // few exceptions are named in each rule's count. The
    // indexer and agent instead check request bodies, agent events, hook
    // payloads, MCP messages, model replies and stored JSON field by field in
    // normalizers that take `unknown`, and the published agent may import only
    // Node's built-ins. Moving to decoders changes what malformed input does,
    // so it is its own piece of work.
    // 74 findings: those field checks (request bodies, agent events, hook and MCP fields, model replies, package.json,
    // the agent's config file, localStorage), three browser feature probes such as `typeof matchMedia === 'function'`,
    // and link.ts telling a mount's named router from a function's router argument (`MountDecl['child']`), which
    // needs a tagged type in every parser that emits mounts.
    "anti-slop/no-runtime-typeof": "off",
    // 22 findings: the normalizers that take raw input (normalizeGrouping, normalizeSorted, cleanFences, cleanRel,
    // clampInt, setGrouping, hook and MCP fields), and the Mongo store's field save and key escaper.
    "anti-slop/no-unknown-parameters": "off",
    // 6 findings: stores return a grouping for normalizeGrouping to check, and the Mongo store's field load and key
    // escaper pass stored documents through.
    "anti-slop/no-unknown-returns": "off",
    // 7 findings: the agent reads Claude Code and MCP messages as Record<string, any>, the normalizers' object guards,
    // and the query an agent read route answers.
    "anti-slop/no-unsafe-dictionary-type": "off",
    // 53 findings: each casts data that was just parsed or received (request bodies, res.json(), JSON.parse of stored
    // files, tokens, SSE and localStorage, model replies, hook and MCP fields, CLI arguments, and normalizer fields
    // already checked by str()). Seven are tests reading HTTP JSON or encodeKeys output. They go when decoders arrive.
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  }
}
