// The map on Cloudflare Workers: static assets from web/dist with no Worker
// script. Paths that aren't files, such as /privacy, get index.html, and
// web/public/_headers sets the response headers.
{
  "name": "fiada-web",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  }
}
