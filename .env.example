# Copy to .env and fill in. .env is gitignored; never commit a connection string.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). When unset,
# projects are saved under .fiada/projects/ instead.
MONGODB_URI=

# Optional: sort each import with a model, so nothing starts in Unlayered or
# Unsorted, and write a short summary of every node. Without a key the
# classifier's result stands and summaries are lines built from the graph.
# With both keys, OpenAI answers unless FIADA_LLM_MODEL names a Claude model.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# FIADA_LLM_MODEL=gpt-5.5

# Optional: which project this indexer serves, and the database that holds
# the `projects` collection.
# FIADA_PROJECT=default
# FIADA_MONGODB_DB=strata  (the database keeps its original name)

# Optional: sign in with GitHub (see "Signing in with GitHub" in the README).
# Everyone then signs in, gets a project of their own, and can import private
# repositories. Create an OAuth app with the callback
# http://localhost:5178/api/auth/github/callback for npm run dev.
# FIADA_GITHUB_CLIENT_ID=
# FIADA_GITHUB_CLIENT_SECRET=
# FIADA_SESSION_SECRET=   (defaults to the client secret)

# Only for an indexer others can reach (see Deploy in the README); set these on
# the host rather than here. Origins whose pages may call the API, and the key
# that changes need.
# FIADA_ALLOWED_ORIGINS=https://fiada.tech,https://hackgt13.vercel.app,https://hackgt13-*-toby-godats-projects.vercel.app
# FIADA_API_KEY=
