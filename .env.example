# Copy to .env and fill in. .env is gitignored; never commit a connection string.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). When unset,
# projects are saved under .strata/projects/ instead.
MONGODB_URI=

# Optional: sort each import with a model, so nothing starts in Unlayered or
# Unsorted, and write a short summary of every node. Without a key the
# classifier's result stands and summaries are lines built from the graph.
# With both keys, OpenAI answers unless STRATA_LLM_MODEL names a Claude model.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# STRATA_LLM_MODEL=gpt-5.5

# Optional: which project this indexer serves, and the database that holds
# the `projects` collection.
# STRATA_PROJECT=default
# STRATA_MONGODB_DB=strata

# Only for an indexer others can reach (see Deploy in the README); set these on
# the host rather than here. Origins whose pages may call the API, and the key
# that changes need.
# STRATA_ALLOWED_ORIGINS=https://hackgt13.vercel.app,https://hackgt13-*-toby-godats-projects.vercel.app
# STRATA_API_KEY=
