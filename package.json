{
  "name": "fiada",
  "private": true,
  "version": "0.1.0",
  "description": "Codebase cartography: one map from repositories down to symbols.",
  "type": "module",
  "workspaces": [
    "shared",
    "indexer",
    "web",
    "agent"
  ],
  "scripts": {
    "dev": "concurrently -k -n indexer,web -c yellow,cyan \"npm:dev -w @strata/indexer\" \"npm:dev -w @fiada/web\"",
    "build": "npm run build -w @fiada/web",
    "typecheck": "tsc -p shared && tsc -p indexer && tsc -p web && tsc -p agent",
    "test": "npm test -w @strata/indexer -w @fiada/web -w @fiadatech/agent",
    "index": "npm run index -w @strata/indexer --",
    "agent:setup": "npm run setup -w @fiadatech/agent --",
    "agent:build": "npm run build -w @fiadatech/agent"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
